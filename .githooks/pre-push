#!/usr/bin/env bash
# Hard rule: block direct pushes to main. All changes go through a feature
# branch + pull request. This mirrors the server-side branch protection on
# binlecode/actop and fails fast locally before a push is rejected by GitHub.
#
# Also nudges when a v* tag is being pushed directly (bare `git push origin
# vX.Y.Z`) — use scripts/tag_release.sh instead; it creates the required
# GitHub Release object alongside the tag.
#
# Enabled via:  git config core.hooksPath .githooks
set -euo pipefail

protected_branch="main"
remote="${1:-}"
warn_tag=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == "refs/heads/${protected_branch}" ]]; then
    echo "" >&2
    echo "BLOCKED: direct push to '${protected_branch}' is not allowed." >&2
    echo "Open a pull request from a feature branch instead:" >&2
    echo "    git switch -c my-feature" >&2
    echo "    git push -u origin my-feature   # then open a PR" >&2
    echo "" >&2
    exit 1
  fi
  if [[ "$remote_ref" =~ ^refs/tags/v ]]; then
    warn_tag=1
  fi
done

if [[ $warn_tag -eq 1 && -z "${ACTOP_TAG_RELEASE:-}" ]]; then
  echo "" >&2
  echo "WARNING: you are pushing a v* tag directly." >&2
  echo "Use scripts/tag_release.sh instead — it creates the required GitHub Release" >&2
  echo "object alongside the tag. A bare tag push creates no release and leaves the" >&2
  echo "project's /releases page incomplete." >&2
  echo "" >&2
  echo "Push anyway?  Proceeding…" >&2
fi

exit 0
